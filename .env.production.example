# =============================================================================
# Yarvo Hotel PMS — Production Environment Template
# =============================================================================
# 1. Copy this file: cp .env.production.example .env.production
# 2. Fill in every CHANGE_ME value
# 3. NEVER commit .env.production to Git
# =============================================================================

# ─── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com          # e.g. yarvohotel.com (no https://)

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=yarvo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=yarvo

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── JWT Secrets (generate: openssl rand -hex 32) ────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookie Secret (generate: openssl rand -hex 32) ──────────────────────────
COOKIE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ─── Public API Key ───────────────────────────────────────────────────────────
PUBLIC_API_KEY=CHANGE_ME_GENERATE_RANDOM_KEY

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
HOTEL_EMAIL=hotel@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ─── WhatsApp Business API (optional) ────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
